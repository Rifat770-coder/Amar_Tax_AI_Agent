# Copy to .env in the project root. Never commit a real key.
OPENAI_API_KEY=replace-me
AMAR_TAX_MODEL=openai/gpt-4o-mini
# Custom API (OpenAI-compatible): uncomment the Base URL below,
# replace OPENAI_API_KEY above with that provider's key, and set AMAR_TAX_MODEL
# above to the exact model ID supplied by that provider.
# OPENAI_BASE_URL=https://your-api-server.example/v1
# Leave OPENAI_BASE_URL unset to use the default OpenAI endpoint.
# Maximum total wait for the UI's AI run; allowed range 10-180 seconds.
AMAR_TAX_CREW_TIMEOUT=60
# Optional JSON rules endpoint. Only an exact match to the assignment DB is accepted.
# AMAR_TAX_RULES_URL=https://your-endpoint.example/rules.json
# Optional locally; mandatory on Render. Use a long random access code.
# This protects the app, and must be DIFFERENT from the provider API key.
# AMAR_TAX_APP_PASSWORD=replace-with-a-long-random-access-code
